FROM python:3.11-slim

# Use a non-root user? Keep root for simplicity in CI/dev images
WORKDIR /app

# Install minimal system deps needed to build a few Python packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    wget \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./

# Upgrade pip and install a small set of pinned runtime packages only
RUN python -m pip install --upgrade pip setuptools wheel

# Install CPU-only torch from the official cpu index to avoid CUDA wheels
RUN pip install --no-cache-dir --extra-index-url https://download.pytorch.org/whl/cpu \
    torch==2.8.0+cpu -f https://download.pytorch.org/whl/cpu/torch_stable.html || true

# Install the requirements but prefer --no-deps to avoid pulling optional heavy deps
RUN pip install --no-cache-dir -r requirements.txt

# sentence-transformers meta package needs transformers, huggingface-hub, tokenizers
RUN pip install --no-cache-dir sentence-transformers==2.2.2 transformers huggingface-hub tokenizers safetensors

COPY . /app

EXPOSE 5001

CMD ["python", "embed_service.py", "--host", "0.0.0.0", "--port", "5001"]
