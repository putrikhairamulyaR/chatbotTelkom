# Copy your real OpenAI key here
OPENAI_API_KEY=
# Qdrant URL (default local Qdrant UI/API)
QDRANT_URL=http://127.0.0.1:6333
# Qdrant API key if used (optional)
QDRANT_API_KEY=
# Collection name
QDRANT_COLLECTION=documents
# Embedding model
EMBED_MODEL=text-embedding-3-small
# Chunk settings (characters)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
# Request batching
BATCH_SIZE=30
